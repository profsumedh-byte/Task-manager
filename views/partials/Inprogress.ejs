<div class="card">

    <div class="card-left">
        <p class="title">In Progress</p>
        <%let inprogress = 0%>
        <%users.forEach((user)=>{%>
        <%if(user.status=='In Progress'){%>
        <%inprogress += 1%>
        <%}%>
        <%})%>
        <h2 class="count"><%= users.length%></h2>
    </div>

    <div class="card-right">
        <i class="fa-solid fa-list-check"></i>
    </div>

</div>