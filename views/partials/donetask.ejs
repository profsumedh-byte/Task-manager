<div class="card">

    <div class="card-left">
        <p class="title">Completed</p>
        <%let done = 0%>
        <%users.forEach((user)=>{%>
        <%if(user.status=='Done'){%>
        <%done += 1%>
        <%}%>
        <%})%>
        <h2 class="count"><%= done%></h2>
    </div>

    <div class="card-right">
        <i class="fa-solid fa-list-check"></i>
    </div>

</div>