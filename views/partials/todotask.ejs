<div class="card">

    <div class="card-left">
        <p class="title">To Do</p>
        <%let todo = 0%>
        <%users.forEach((user)=>{%>
        <%if(user.status=='To Do'){%>
        <%todo += 1%>
        <%}%>
        <%})%>
        <h2 class="count"><%= todo%></h2>
    </div>

    <div class="card-right">
        <i class="fa-solid fa-list-check"></i>
    </div>

</div>